/* ConnectCore 6 QuadPlus (common) */
#include "imx6qp-ccimx6.dtsi"

/ {
	bluetooth: bluetooth {
		/* U-Boot will fill in the MAC address here */
	};

	usdhc1_wifi_pwrseq: usdhc1-wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		post-power-on-delay-ms = <5>;
		reset-gpios = <&gpio_extender 3 GPIO_ACTIVE_LOW>; /* WL_DISABLE */
	};

	wireless {
		/* U-Boot will fill in the MAC address here */
	};
};

&i2c2 {
	pmic_dialog: dialog@58 {
		regulators {
			bio {
				regulator-always-on;
			};

			ldo2 {
				regulator-always-on;
			};
		};
	};
};

/* UART2 (Bluetooth) */
&uart2 {
	status = "okay";
};

/* USDHC1 (Wireless) */
&usdhc1 {
	no-1-8-v;
	mmc-pwrseq = <&usdhc1_wifi_pwrseq>;
	status = "okay";
};
