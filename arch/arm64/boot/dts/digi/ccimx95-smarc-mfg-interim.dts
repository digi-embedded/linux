/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
/* i.MX95 CPU */
#include "../freescale/imx95.dtsi"
/* Digi ConnectCore 95 (SOM) */
#include "ccimx95.dtsi"
/* Digi ConnectCore 95 SMARC card for SOM */
#include "ccimx95-smarc.dtsi"

/ {
	model = "Digi International ConnectCore 95 DVK";
	compatible = "digi,ccimx95-dvk", "digi,ccimx95", "fsl,imx95-19x19-evk", "fsl,imx95";
	digi,machine,name = "ccimx95-dvk";

	aliases {
		ethernet0 = &enetc_port0;
		ethernet1 = &enetc_port1;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_hdmi_hpd>;
		ddc-i2c-bus = <&lpi2c2>;
		hdmi-pwr-supply = <&reg_5v_board>;
		hpd-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		label = "hdmi";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};

	/* Required placeholder to inject LVDS0 overlay */
	lvds0-panel {
		status = "disabled";
	};

	/* Required placeholder to inject LVDS1 overlay */
	lvds1-panel {
		status = "disabled";
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		/* Enabled by SMARC_CARRIER_PWR_ON (MCA) */
		reg_board_main: regulator-board-main {
			compatible = "regulator-fixed";
			regulator-name = "reg_main";
			enable-active-high;
		};

		reg_1v8_board: regulator-1v8-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <1800000>;
			regulator-min-microvolt = <1800000>;
			regulator-name = "1v8_board";
			vin-supply = <&reg_board_main>;
		};

		reg_3v3_board: regulator-3v3-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <3300000>;
			regulator-min-microvolt = <3300000>;
			regulator-name = "3v3_board";
			vin-supply = <&reg_board_main>;
		};

		reg_5v_board: regulator-5v-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <5000000>;
			regulator-min-microvolt = <5000000>;
			regulator-name = "5v_board";
			vin-supply = <&reg_board_main>;
		};
	};

	sound_max98089: sound-max98089 {
		compatible = "fsl,imx-audio-max98088";
		model = "max98088-audio";
		audio-cpu = <&sai3>;
		audio-codec = <&max98089>;
		audio-routing =
			"Headphone Jack", "HPL",
			"Headphone Jack", "HPR",
			"Ext Spk", "SPKL",
			"Ext Spk", "SPKR",
			"Line Out Jack", "RECL",
			"Line Out Jack", "RECR",
			"Mic Jack", "MIC2",
			"Line In Jack", "INA1",
			"Line In Jack", "INA2",
			"Line In Jack", "INB1",
			"Line In Jack", "INB2";
	};
};

&cm7 {
	status = "disabled";
};

&csi_pixel_formatter_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			formatter_0_in: endpoint {
				remote-endpoint = <&mipi_csi0_out>;
			};
		};

		port@1 {
			reg = <1>;

			formatter_0_out: endpoint {
				remote-endpoint = <&isi_in_2>;
			};
		};
	};
};

&displaymix_irqsteer {
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dphy_rx {
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <4008000000>, <445333334>;
	status = "okay";
};

&flexcan2 {
	xceiver-supply = <&reg_5v_board>;
};

&flexcan3 {
	xceiver-supply = <&reg_5v_board>;
};

&flexspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1>;
	/*
	 * TODO: reset line unsupported by FlexSPI driver
	 * SMARC_ESPI_RESET# comes from MCA PA12
	 */
	status = "disabled";
};

&isi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		* ISI ports 0 and 1 are fed by DPU pixel-link outputs.
		* ISI ports 2 and 3 are fed by CameraMix
		* (formatter/interleaver) outputs.
		*/
		port@2 {
			reg = <2>;

			isi_in_2: endpoint {
				remote-endpoint = <&formatter_0_out>;
			};
		};
	};
};

&lpi2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	/* MIPI-CSI camera */
	os08a20: os08a20_mipi@36 {
		compatible = "ovti,os08a20";
		reg = <0x36>;
		/* MIPI_CSI1_PWDN#: MCA PA3 */
		reset-gpios = <&mca_gpio 0 GPIO_ACTIVE_LOW>;
		orientation = <2>;
		rotation = <0>;
		status = "okay";

		port {
			os08a20_mipi_0_ep: endpoint {
				remote-endpoint = <&mipi_csi0_ep>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};
	};

	lt_bridge: lt8912@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		vdd-supply = <&reg_vdd_1v8_dummy>;
		vccmipirx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmitx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmipll-supply = <&reg_vdd_1v8_dummy>;
		vcclvdstx-supply = <&reg_vdd_1v8_dummy>;
		vccsysclk-supply = <&reg_vdd_1v8_dummy>;
		vcclvdspll-supply = <&reg_vdd_1v8_dummy>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt8912_1_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&mipi_dsi_hdmi_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	max98089: codec@10 {
		compatible = "maxim,max98089";
		reg = <0x10>;
		clocks = <&scmi_clk IMX95_CLK_SAI3>;
		clock-names = "mclk";
		dvdd-supply = <&reg_vdd_1v8_dummy>;
	};
};

&lpi2c7 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	status = "okay";

	ptn5110: tcpc@53 {
		compatible = "nxp,ptn5110";
		reg = <0x53>;
		interrupt-parent = <&mca_gpio>;
		interrupts = <15 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ptn5110>;

		port {
			typec_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};

		typec_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 0, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <0>;
			self-powered;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					typec_con_ss: endpoint {
						remote-endpoint = <&usb3_data_ss>;
					};
				};
			};
		};
	};
};

&lpspi1 {
	status = "disabled";

	spidev0: spi@0 {
		/*
		 * spidev uses a compatible string 'rohm,fs2228fv' to have the
		 * driver create an spi device node. This is just an example,
		 * there is not a real device connected on the SPI bus.
		 */
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/* Console */
&lpuart1 {
	/* Errata: DMA does not work on LPUART1 */
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/* LPUART3 routed to RS485 transceiver */
&lpuart3 {
	/*
	 * Disable RS485 on DVKv2 because DE/RE# line is an MCA_IO
	 * that cannot be toggled in interrupt context.
	 */
	// linux,rs485-enabled-at-boot-time;
	// digi,rts-gpio = <&mca_gpio 18 GPIO_ACTIVE_HIGH>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/* LPUART7 routed to XBee connector */
&lpuart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>, <&pinctrl_xbee_gpios>;
	status = "disabled";
};

&mipi_csi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			mipi_csi0_ep: endpoint {
				remote-endpoint = <&os08a20_mipi_0_ep>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};

		port@1 {
			reg = <1>;
			mipi_csi0_out: endpoint {
				remote-endpoint = <&formatter_0_in>;
			};
		};
	};
};

&mipi_dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			mipi_dsi_hdmi_out: endpoint {
				remote-endpoint = <&lt8912_1_in>;
			};
		};
	};
};

&neoisp0 {
	compatible = "nxp,imx95-b0-neoisp";
	status = "okay";
};

/* M.2 E-Key slot */
&pcie0 {
	vpcie-supply = <&reg_3v3_board>;
	reset-gpios = <&mca_gpio 25 GPIO_ACTIVE_LOW>;	/* MCA PB10 */
};

/* M.2 B-Key slot */
&pcie1 {
	vpcie-supply = <&reg_3v3_board>;
	reset-gpios = <&mca_gpio 10 GPIO_ACTIVE_LOW>;	/* MCA PB1 */
};

&pcie1_ep {
	vpcie-supply = <&reg_3v3_board>;
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&usb2 {
	/* On SMARC DVKv1 powered directly from VIN_5V */
	vbus-supply = <&reg_board_main>;
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "host";
	snps,dis-u1-entry-quirk;
	snps,dis-u2-entry-quirk;
	status = "okay";

	port {
		usb3_drd_sw: endpoint {
			remote-endpoint = <&typec_dr_sw>;
		};
	};
};

&usb3_phy {
	vbus-supply = <&reg_5v_board>;
	fsl,phy-pcs-tx-deemph-3p5db-attenuation-db = <17>;
	fsl,phy-pcs-tx-swing-full-percent = <100>;
	fsl,phy-tx-preemp-amp-tune-microamp = <600>;
	fsl,phy-tx-vboost-level-microvolt = <1156>;
	status = "okay";

	port {
		usb3_data_ss: endpoint {
			remote-endpoint = <&typec_con_ss>;
		};
	};
};

/* MicroSD */
&usdhc2 {
	vmmc-supply = <&reg_3v3_board>;
};

&wdog3 {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio>;

	/* GPIOs for User Leds, Buttons, ... */
	pinctrl_gpio: gpiogrp {
		fsl,pins = <
			/* XBEE_UART_RX_3V3 - J20.2 */
			IMX95_PAD_GPIO_IO37__GPIO5_IO_BIT17	0x31e
			/* XBEE_UART_TX_3V3 - J20.3 */
			IMX95_PAD_GPIO_IO36__GPIO5_IO_BIT16	0x31e
			/* XBEE_RESET#_3V3 - J20.5 */
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7	0x31e
			/* XBEE_UART_RTS_3V3 - J21.5 */
			IMX95_PAD_GPIO_IO11__GPIO2_IO_BIT11	0x31e
			/* XBEE_UART_CTS_3V3 - J21.9 */
			IMX95_PAD_GPIO_IO10__GPIO2_IO_BIT10	0x31e

			/* GPIO4_IO29 - J22.1 */
			IMX95_PAD_CCM_CLKO4__GPIO4_IO_BIT29	0x31e
			/* GPIO3_IO27 - J22.1 */
			IMX95_PAD_CCM_CLKO2__GPIO3_IO_BIT27	0x31e

			/* I2C5_SCL - J23.2 */
			IMX95_PAD_GPIO_IO23__GPIO2_IO_BIT23	0x31e
			/* I2C5_SDA - J23.3 */
			IMX95_PAD_GPIO_IO22__GPIO2_IO_BIT22	0x31e

			/* SPI1_SS0 - J24.1 */
			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11	0x31e
			/* SPI1_SS1 - J24.2 */
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x31e
			/* SPI1_SCK - J24.3 */
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_GPIO1_IO_BIT13	0x31e
			/* SPI1_MISO - J24.4 */
			IMX95_PAD_SAI1_TXC__AONMIX_TOP_GPIO1_IO_BIT12	0x31e
			/* SPI1_MOSI - J24.5 */
			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_GPIO1_IO_BIT14	0x31e

			/* SAI5_TXFS - J25.2 */
			IMX95_PAD_XSPI1_DATA5__GPIO5_IO_BIT5	0x31e
			/* SAI5_TXD - J25.3 */
			IMX95_PAD_XSPI1_DATA4__GPIO5_IO_BIT4	0x31e
			/* SAI5_RXD - J25.4 */
			IMX95_PAD_XSPI1_DATA7__GPIO5_IO_BIT7	0x31e
			/* SAI5_TXC - J25.5 */
			IMX95_PAD_XSPI1_DATA6__GPIO5_IO_BIT6	0x31e

			/* XSPI1_SCLK - J26.1 */
			IMX95_PAD_XSPI1_SCLK__GPIO5_IO_BIT9	0x31e
			/* XSPI1_SS0 - J26.2 */
			IMX95_PAD_XSPI1_SS0_B__GPIO5_IO_BIT10	0x31e
			/* XSPI1_DATA0 - J26.3 */
			IMX95_PAD_XSPI1_DATA0__GPIO5_IO_BIT0	0x31e
			/* XSPI1_SS1 - J26.4 */
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11	0x31e
			/* XSPI1_DATA1 - J26.5 */
			IMX95_PAD_XSPI1_DATA1__GPIO5_IO_BIT1	0x31e
			/* XSPI1_ALERT0# - J26.6 */
			IMX95_PAD_XSPI1_DQS__GPIO5_IO_BIT8	0x31e
			/* XSPI1_DATA2 - J26.7 */
			IMX95_PAD_XSPI1_DATA2__GPIO5_IO_BIT2	0x31e
			/* XSPI1_DATA3 - J26.9 */
			IMX95_PAD_XSPI1_DATA3__GPIO5_IO_BIT3	0x31e
		>;
	};

	pinctrl_hdmi_hpd: hdmi_hpd_grp {
		fsl,pins = <
			IMX95_PAD_PDM_CLK__AONMIX_TOP_GPIO1_IO_BIT8	0x31e
		>;
	};

	pinctrl_ptn5110: ptn5110grp {
		fsl,pins = <
			/* PTN5110 debug irq (DBG_ACC) line */
			IMX95_PAD_ENET1_MDC__GPIO4_IO_BIT0		0x31e
		>;
	};

	/* XBee RF IO lines */
	pinctrl_xbee_gpios: xbeegrp {
		fsl,pins = <
			/* XBEE_RESET_N */
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7		0x31e
		>;
	};
};
