 */

/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
/* i.MX95 CPU */
#include "../freescale/imx95.dtsi"
/* Digi ConnectCore 95 (SOM) */
#include "ccimx95.dtsi"

/ {
	model = "Digi International ConnectCore 95 DVK";
	compatible = "digi,ccimx95-dvk", "digi,ccimx95", "fsl,imx95-19x19-evk", "fsl,imx95";
	digi,machine,name = "ccimx95-dvk";

	aliases {
		ethernet0 = &enetc_port0;
		ethernet1 = &enetc_port1;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_hdmi_hpd>;
		ddc-i2c-bus = <&lpi2c4>;
		hdmi-pwr-supply = <&reg_5v_dvk>;
		hpd-gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
		label = "hdmi";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};

	/* Required placeholder to inject LVDS0 overlay */
	lvds0-panel {
		status = "disabled";
	};

	/* Required placeholder to inject LVDS1 overlay */
	lvds1-panel {
		status = "disabled";
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_3v3_dvk: regulator-3v3-dvk {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_3v3_dvk>;
			regulator-max-microvolt = <3300000>;
			regulator-min-microvolt = <3300000>;
			regulator-name = "3v3_dvk";
			gpio = <&gpio5 14 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};

		reg_5v_dvk: regulator-5v-dvk {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_5v_dvk>;
			regulator-max-microvolt = <5000000>;
			regulator-min-microvolt = <5000000>;
			regulator-name = "5v_dvk";
			gpio = <&gpio1 14 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};

		reg_can1_stby: regulator-can1-stby {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_can1_stby>;
			regulator-name = "can1-stby";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&gpio1 11 GPIO_ACTIVE_LOW>;
			vin-supply = <&reg_5v_dvk>;
		};

		reg_can2_stby: regulator-can2-stby {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_can2_stby>;
			regulator-name = "can2-stby";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&gpio1 13 GPIO_ACTIVE_LOW>;
			vin-supply = <&reg_5v_dvk>;
		};
	};

	sound_max98089: sound-max98089 {
		compatible = "fsl,imx-audio-max98088";
		model = "max98088-audio";
		audio-cpu = <&sai3>;
		audio-codec = <&max98089>;
		audio-routing =
			"Headphone Jack", "HPL",
			"Headphone Jack", "HPR",
			"Ext Spk", "SPKL",
			"Ext Spk", "SPKR",
			"Line Out Jack", "RECL",
			"Line Out Jack", "RECR",
			"Mic Jack", "MIC2",
			"Line In Jack", "INA1",
			"Line In Jack", "INA2",
			"Line In Jack", "INB1",
			"Line In Jack", "INB2";
	};
};

&adc1 {
	vref-supply = <&reg_vdd_1v8_dummy>;
	status = "okay";
};

&displaymix_irqsteer {
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <4008000000>, <445333334>;
	status = "okay";
};

&flexcan1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan1>;
	pinctrl-1 = <&pinctrl_flexcan1_sleep>;
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan2>;
	pinctrl-1 = <&pinctrl_flexcan2_sleep>;
	xceiver-supply = <&reg_can2_stby>;
	status = "okay";
};

&flexspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1>;
	status = "disabled";

	/* TODO: switch to use reset-gpios */
	//reset-gpios = <&gpio5 11 GPIO_ACTIVE_LOW>;

	pinctrl-assert-gpios = <&gpio5 11 GPIO_ACTIVE_HIGH>;
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	status = "okay";

	ext_rtc: ext_rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rtc>;
		interrupt-parent = <&gpio2>;
		interrupts = <31 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};

	ptn5110: tcpc@53 {
		compatible = "nxp,ptn5110";
		reg = <0x53>;
		interrupt-parent = <&gpio1>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ptn5110>;

		port {
			typec_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};

		typec_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "source";
			data-role = "dual";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					typec_con_ss: endpoint {
						remote-endpoint = <&usb3_data_ss>;
					};
				};
			};
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	pinctrl-1 = <&pinctrl_lpi2c4>;
	status = "okay";

	lt_bridge: lt8912@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lt8912>;
		reset-gpios = <&gpio3 26 GPIO_ACTIVE_LOW>;
		vdd-supply = <&reg_vdd_1v8_dummy>;
		vccmipirx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmitx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmipll-supply = <&reg_vdd_1v8_dummy>;
		vcclvdstx-supply = <&reg_vdd_1v8_dummy>;
		vccsysclk-supply = <&reg_vdd_1v8_dummy>;
		vcclvdspll-supply = <&reg_vdd_1v8_dummy>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt8912_1_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&mipi_dsi_hdmi_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};

	max98089: codec@10 {
		compatible = "maxim,max98089";
		reg = <0x10>;
		clocks = <&scmi_clk IMX95_CLK_SAI3>;
		clock-names = "mclk";
		dvdd-supply = <&reg_vdd_1v8_dummy>;
	};
};

/* mikroBUS SPI interface */
&lpspi8 {
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi8>;
	pinctrl-1 = <&pinctrl_lpspi8_gpio>;
	cs-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev0: spi@0 {
		/*
		 * spidev uses a compatible string 'rohm,fs2228fv' to have the
		 * driver create an spi device node. This is just an example,
		 * there is not a real device connected on the SPI bus.
		 */
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&lpuart1 {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	/* Errata: DMA does not work on LPUART1 */
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/*
 * XBee interface
 * LPUART4 lines conflict with ENET2.
 */
&lpuart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>, <&pinctrl_xbee_rf_gpios>;
	fsl,uart-has-rtscts;
	status = "okay";
};

/*
 * RS485/mikroBUS UART
 * The uart of the RS485 and the mikroBUS interfaces is shared. Configure the
 * corresponding jumpers to select the desired functionality.
 */
&lpuart7 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_uart7>;
	linux,rs485-enabled-at-boot-time;
	digi,rts-gpio = <&gpio2 10 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&enetc_port0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_enetc0>;
	pinctrl-1 = <&pinctrl_enetc0_sleep>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&enetc_port1 {
	status = "disabled";
};

&mipi_dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			mipi_dsi_hdmi_out: endpoint {
				remote-endpoint = <&lt8912_1_in>;
			};
		};
	};
};

&netc_emdio {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emdio>;
	status = "okay";

	ethphy0: ethernet-phy@0 {
		reg = <0>;
		compatible = "ethernet-phy-ieee802.3-c22";
		status = "okay";
	};

	ethphy1: ethernet-phy@1 {
		reg = <1>;
		compatible = "ethernet-phy-ieee802.3-c22";
		status = "okay";
	};
};

&netc_prb_ierb {
	netc-interfaces = <NXP_NETC_RGMII
			   NXP_NETC_RGMII
			   NXP_NETC_SERIAL>;
};

&netc_timer {
	status = "okay";
};

&pcie0 {
	vpcie-supply = <&reg_3v3_dvk>;
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	status = "okay";
};

/*
 * Disabled by default. To enable it, on the DVK, 0-ohm selection resistors must
 * be swapped from PCIE0 lines to the PCIE1 lines.
 */
&pcie1 {
	vpcie-supply = <&reg_3v3_dvk>;
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	status = "disabled";
};

&pcie1_ep {
	vpcie-supply = <&reg_3v3_dvk>;
	status = "disabled";
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&sai3 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_sai3>;
	pinctrl-1 = <&pinctrl_sai3_sleep>;
	assigned-clocks = <&scmi_clk IMX95_CLK_AUDIOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL1>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2>,
			  <&scmi_clk IMX95_CLK_SAI3>;
	assigned-clock-parents = <0>, <0>, <0>, <0>,
				 <&scmi_clk IMX95_CLK_AUDIOPLL1>;
	assigned-clock-rates = <3932160000>,
			       <3612672000>, <393216000>,
			       <361267200>, <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

/* PWM line on MikroBUS connector */
&tpm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm3>;
	status = "okay";
};

&usb2 {
	dr_mode = "host";
	vbus-supply = <&reg_5v_dvk>;
	disable-over-current;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "none";
	snps,dis-u1-entry-quirk;
	snps,dis-u2-entry-quirk;
	status = "okay";

	port {
		usb3_drd_sw: endpoint {
			remote-endpoint = <&typec_dr_sw>;
		};
	};
};

&usb3_phy {
	fsl,phy-pcs-tx-deemph-3p5db-attenuation-db = <17>;
	fsl,phy-pcs-tx-swing-full-percent = <100>;
	fsl,phy-tx-preemp-amp-tune-microamp = <600>;
	fsl,phy-tx-vboost-level-microvolt = <1156>;
	vbus-supply = <&reg_5v_dvk>;
	status = "okay";

	port {
		usb3_data_ss: endpoint {
			remote-endpoint = <&typec_con_ss>;
		};
	};
};

/* MicroSD */
&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	vmmc-supply = <&reg_vdd_3v3_dummy>;
	vqmmc-supply = <&scmi_vdd_sdio2>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_HIGH>;
	fsl,cd-gpio-wakeup-disable;
	bus-width = <4>;
	status = "okay";
};

&vpuctrl {
	boot = <&vpu_boot>;
	sram = <&sram1>;
};

&wdog3 {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio>, <&pinctrl_gpio_shared_enet2>;

	/* GPIOs for User Leds, Buttons, ... */
	pinctrl_gpio: gpiogrp {
		fsl,pins = <
			/* ULED/BUTTON1 */
			IMX95_PAD_GPIO_IO32__GPIO5_IO_BIT12		0x31e
			/* J41.3 */
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7		0x31e
		>;
	};

	/* Shared GPIOs with ENET2 to be removed with overlay */
	pinctrl_gpio_shared_enet2: gpiosharedenet2grp {
		fsl,pins = <
			/* IND RST 15.4 */
			IMX95_PAD_ENET2_TD2__GPIO4_IO_BIT17		0x31e
			/* ULED/BUTTON2 */
			IMX95_PAD_ENET2_RXC__GPIO4_IO_BIT23		0x31e
			/* J41.5 */
			IMX95_PAD_ENET2_TD3__GPIO4_IO_BIT16		0x31e
			/* J41.7 */
			IMX95_PAD_ENET2_TX_CTL__GPIO4_IO_BIT20		0x31e
			/* J41.4 */
			IMX95_PAD_ENET2_RX_CTL__GPIO4_IO_BIT22		0x31e
			/* J41.6 */
			IMX95_PAD_ENET2_RD1__GPIO4_IO_BIT25		0x31e
			/* J41.8 */
			IMX95_PAD_ENET2_RD3__GPIO4_IO_BIT27		0x31e
		>;
	};

	pinctrl_emdio: emdiogrp{
		fsl,pins = <
			IMX95_PAD_ENET1_MDC__NETCMIX_TOP_NETC_MDC	0x57e
			IMX95_PAD_ENET1_MDIO__NETCMIX_TOP_NETC_MDIO	0x97e
		>;
	};

	pinctrl_enetc0: enetc0grp {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__NETCMIX_TOP_ETH0_RGMII_TD3		0x57e
			IMX95_PAD_ENET1_TD2__NETCMIX_TOP_ETH0_RGMII_TD2		0x57e
			IMX95_PAD_ENET1_TD1__NETCMIX_TOP_ETH0_RGMII_TD1		0x57e
			IMX95_PAD_ENET1_TD0__NETCMIX_TOP_ETH0_RGMII_TD0		0x57e
			IMX95_PAD_ENET1_TX_CTL__NETCMIX_TOP_ETH0_RGMII_TX_CTL	0x57e
			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x58e
			IMX95_PAD_ENET1_RX_CTL__NETCMIX_TOP_ETH0_RGMII_RX_CTL	0x57e
			IMX95_PAD_ENET1_RXC__NETCMIX_TOP_ETH0_RGMII_RX_CLK	0x58e
			IMX95_PAD_ENET1_RD0__NETCMIX_TOP_ETH0_RGMII_RD0		0x57e
			IMX95_PAD_ENET1_RD1__NETCMIX_TOP_ETH0_RGMII_RD1		0x57e
			IMX95_PAD_ENET1_RD2__NETCMIX_TOP_ETH0_RGMII_RD2		0x57e
			IMX95_PAD_ENET1_RD3__NETCMIX_TOP_ETH0_RGMII_RD3		0x57e
		>;
	};

	pinctrl_enetc0_sleep: enetc0grp-sleep {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__GPIO4_IO_BIT2		0x200
			IMX95_PAD_ENET1_TD2__GPIO4_IO_BIT3		0x200
			IMX95_PAD_ENET1_TD1__GPIO4_IO_BIT4		0x200
			IMX95_PAD_ENET1_TD0__GPIO4_IO_BIT5		0x200
			IMX95_PAD_ENET1_TX_CTL__GPIO4_IO_BIT6		0x200
			IMX95_PAD_ENET1_TXC__GPIO4_IO_BIT7		0x200
			IMX95_PAD_ENET1_RX_CTL__GPIO4_IO_BIT8		0x200
			IMX95_PAD_ENET1_RXC__GPIO4_IO_BIT9		0x200
			IMX95_PAD_ENET1_RD0__GPIO4_IO_BIT10		0x200
			IMX95_PAD_ENET1_RD1__GPIO4_IO_BIT11		0x200
			IMX95_PAD_ENET1_RD2__GPIO4_IO_BIT12		0x200
			IMX95_PAD_ENET1_RD3__GPIO4_IO_BIT13		0x200
		>;
	};

	pinctrl_flexcan1: flexcan1grp {
		fsl,pins = <
			IMX95_PAD_PDM_CLK__AONMIX_TOP_CAN1_TX		0x39e
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_CAN1_RX	0x39e
		>;
	};

	pinctrl_flexcan1_sleep: flexcan1grpsleep {
		fsl,pins = <
			IMX95_PAD_PDM_CLK__AONMIX_TOP_GPIO1_IO_BIT8		0x200
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x200
		>;
	};

	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO25__CAN2_TX			0x39e
			IMX95_PAD_GPIO_IO27__CAN2_RX			0x39e
		>;
	};

	pinctrl_flexcan2_sleep: flexcan2grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO25__GPIO2_IO_BIT25		0x200
			IMX95_PAD_GPIO_IO27__GPIO2_IO_BIT27		0x200
		>;
	};

	pinctrl_flexspi1: flexspi1grp {
		fsl,pins = <
			IMX95_PAD_XSPI1_SS0_B__FLEXSPI1_A_SS0_B		0x3fe
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11		0x3fe
			IMX95_PAD_XSPI1_SCLK__FLEXSPI1_A_SCLK		0x3fe
			IMX95_PAD_XSPI1_DQS__FLEXSPI1_A_DQS		0x3fe
			IMX95_PAD_XSPI1_DATA0__FLEXSPI1_A_DATA_BIT0	0x3fe
			IMX95_PAD_XSPI1_DATA1__FLEXSPI1_A_DATA_BIT1	0x3fe
			IMX95_PAD_XSPI1_DATA2__FLEXSPI1_A_DATA_BIT2	0x3fe
			IMX95_PAD_XSPI1_DATA3__FLEXSPI1_A_DATA_BIT3	0x3fe
			IMX95_PAD_XSPI1_DATA4__FLEXSPI1_A_DATA_BIT4	0x3fe
			IMX95_PAD_XSPI1_DATA5__FLEXSPI1_A_DATA_BIT5	0x3fe
			IMX95_PAD_XSPI1_DATA6__FLEXSPI1_A_DATA_BIT6	0x3fe
			IMX95_PAD_XSPI1_DATA7__FLEXSPI1_A_DATA_BIT7	0x3fe
		>;
	};

	/* HDMI HPD */
	pinctrl_hdmi_hpd: hdmi_hpd_grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7		0x31e
		>;
	};

