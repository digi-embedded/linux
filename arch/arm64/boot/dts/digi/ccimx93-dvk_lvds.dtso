/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

#include "../freescale/imx93-pinfunc.h"

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			overlay-description = "DVK: AUO 10.1 LVDS display";

			lvds_backlight: lvds_backlight {
				compatible = "pwm-backlight";
				pwms = <&tpm6 1 50000 0>;
				brightness-levels = <0 20 25 30 35 40 100>;
				default-brightness-level = <6>;
				status = "okay";
			};

			lvds_panel: lvds_panel {
				compatible = "panel-lvds";
				status = "okay";
				backlight = <&lvds_backlight>;
				power-supply = <&reg_5v_board>;
				data-mapping = "jeida-24";
				de-high;
				width-mm = <216>;
				height-mm = <135>;

				/* AUO G101EVN01.0 */
				panel-timing {
					clock-frequency = <68930000>;
					hactive = <1280>;
					vactive = <800>;
					hfront-porch = <120>;
					hback-porch = <2>;
					hsync-len = <8>;
					vback-porch = <10>;
					vfront-porch = <2>;
					vsync-len = <6>;
					hsync-active = <1>;
					vsync-active = <1>;
				};

				port {
					panel_lvds_in: endpoint {
						remote-endpoint = <&lvds_out>;
					};
				};
			};
		};
	};

	/* Disable the HDMI bridge */
	fragment@1 {
		target = <&lt_bridge>;
		__overlay__ {
			status = "disabled";
		};
	};
	/* Disable MIPI DSI phy */
	fragment@2 {
		target = <&dphy>;
		__overlay__ {
			status = "disabled";
		};
	};

	/* Disable MIPI DSI */
	fragment@3 {
		target = <&dsi>;
		__overlay__ {
			status = "disabled";
		};
	};

	/* Enable the LVDS bridge */
	fragment@4 {
		target = <&ldb>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			lvds-channel@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				port@1 {
					reg = <1>;

					lvds_out: endpoint {
						remote-endpoint = <&panel_lvds_in>;
					};
				};
			};
		};
	};

	/* Enable the LVDS phy */
	fragment@5 {
		target = <&ldb_phy>;
		__overlay__ {
			status = "okay";
		};
	};

	/* Enable the LVDS backlight PWM */
	fragment@6 {
		target = <&tpm6>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_tpm6>;
			status = "okay";
		};
	};

	/* Enable the lvds_backlight */
	fragment@7 {
		target = <&lvds_backlight>;
		__overlay__ {
			status = "okay";
		};
	};

	/* Adjust lcdif clock */
	fragment@8 {
		target = <&lcdif>;
		__overlay__ {
			status = "okay";
			assigned-clock-rates = <498000000>, <68930000>, <400000000>, <133333333>;
		};
	};

	/* Enable goodix_touch */
	fragment@9 {
		target = <&lpi2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			goodix_touch: gt9271@14 {
				compatible = "goodix,gt9271";
				reg = <0x14>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_touch>;
				/* LVDS interrupt */
				interrupt-parent = <&gpio2>;
				interrupts = <24 IRQ_TYPE_EDGE_FALLING>;
				irq-gpios = <&gpio2 24 GPIO_ACTIVE_HIGH>;
				reload-fw-on-resume;
				skip-firmware-request;
				vin-supply = <&reg_5v_board>;
				status = "okay";
			};
		};
	};

	fragment@10 {
		target = <&iomuxc>;
		__overlay__ {
			/* LVDS touch interface IOs */
			pinctrl_touch: touchgrp {
				fsl,pins = <
					/* LVDS touch interrupt */
					MX93_PAD_GPIO_IO24__GPIO2_IO24		0x31e
				>;
			};

			/* LVDS PWM backlight */
			pinctrl_tpm6: tpm6grp {
				fsl,pins = <
					MX93_PAD_GPIO_IO23__TPM6_CH1		0x19e
				>;
			};

		};
	};
};
