#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>

&flexcan2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan2>;
	pinctrl-1 = <&pinctrl_flexcan2_sleep>;
	status = "okay";
};

&flexcan3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan3>;
	pinctrl-1 = <&pinctrl_flexcan3_sleep>;
	status = "okay";
};

&flexspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1_sleep>;
};

&lpi2c2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2_sleep>;
};

&lpi2c4 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	pinctrl-1 = <&pinctrl_lpi2c4_sleep>;
};

&lpi2c5 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	pinctrl-1 = <&pinctrl_lpi2c5_sleep>;
};

&lpi2c7 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c7>;
	pinctrl-1 = <&pinctrl_lpi2c7_sleep>;
};

&lpi2c8 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c8>, <&pinctrl_mca>;
	pinctrl-1 = <&pinctrl_lpi2c8_sleep>, <&pinctrl_mca>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	mca_cc95_smarc: mca@20 {
		compatible = "digi,mca-stm32u031";
		reg = <0x20>;
		interrupt-parent = <&gpio2>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		interrupt-controller;
		#interrupt-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mca>;

		mca_gpio: gpio {
			compatible = "digi,mca-gpio";
			gpio-controller;
			#gpio-cells = <2>;

			interrupt-parent = <&mca_cc95_smarc>;
			interrupt-controller;
			#interrupt-cells = <2>;

			/* Disable all mca GPIOs as power off wake up sources */
			pwroff-wakeup-capable-ios = <>;
		};

		rtc {
			compatible = "digi,mca-rtc";
		};

		wdt {
			compatible = "digi,mca-wdt";
			digi,full-reset;
		};

		gpio_wdt: gpio-wdt {
			compatible = "digi,mca-gpio-wdt";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			gpio_wdt0: gpio-wdt@210 {
				reg = <0x210>;
				status = "disabled";
			};

			gpio_wdt1: gpio-wdt@220 {
				reg = <0x220>;
				status = "disabled";
			};

			gpio_wdt2: gpio-wdt@230 {
				reg = <0x230>;
				status = "disabled";
			};

			gpio_wdt3: gpio-wdt@240 {
				reg = <0x240>;
				status = "disabled";
			};
		};

		pwrkey {
			compatible = "digi,mca-smarc-pwrkey";
			digi,key-power;
			digi,key-power-up;
			digi,key-sleep;
			digi,debounce-ms = <100>;
			digi,pwroff-delay-sec = <6>;
		};
	};
};

&lpspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi1>;
	pinctrl-1 = <&pinctrl_lpspi1_sleep>;
	num-cs = <2>;
	cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>,	/* CS0 */
		   <&gpio1 9 GPIO_ACTIVE_LOW>;	/* CS1 */
};

&lpuart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
};

&lpuart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
};

&lpuart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
};

&enetc_port0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_enetc0>;
	pinctrl-1 = <&pinctrl_enetc0_sleep>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&enetc_port1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_enetc1>;
	pinctrl-1 = <&pinctrl_enetc1_sleep>;
	phy-handle = <&ethphy1>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&netc_emdio {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emdio>;
	status = "okay";

	ethphy0: ethernet-phy@5 {
		reg = <5>;
		compatible = "ethernet-phy-ieee802.3-c22";
		status = "okay";
	};

	ethphy1: ethernet-phy@7 {
		reg = <7>;
		compatible = "ethernet-phy-ieee802.3-c22";
		status = "okay";
	};
};

&netc_prb_ierb {
	netc-interfaces = <NXP_NETC_RGMII
			   NXP_NETC_RGMII
			   NXP_NETC_SERIAL>;
};

&netc_timer {
	status = "okay";
};

&pcie0 {
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	status = "okay";
};

&pcie1 {
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	status = "okay";
};

&sai3 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_sai3>;
	pinctrl-1 = <&pinctrl_sai3_sleep>;
	assigned-clocks = <&scmi_clk IMX95_CLK_AUDIOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL1>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2>,
			  <&scmi_clk IMX95_CLK_SAI3>;
	assigned-clock-parents = <0>, <0>, <0>, <0>,
				 <&scmi_clk IMX95_CLK_AUDIOPLL1>;
	assigned-clock-rates = <3932160000>,
			       <3612672000>, <393216000>,
			       <361267200>, <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

/* Disable BBM (i.MX95 RTC and ON/OFF key) */
&scmi_bbm {
	status = "disabled";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>, <&pinctrl_usdhc2_gpio>;
	vqmmc-supply = <&scmi_vdd_sdio2>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_HIGH>;
	fsl,cd-gpio-wakeup-disable;
	bus-width = <4>;
	status = "okay";
};

&vpuctrl {
	boot = <&vpu_boot>;
	sram = <&sram1>;
};

&scmi_iomuxc {
	pinctrl_emdio: emdiogrp{
		fsl,pins = <
			IMX95_PAD_ENET2_MDC__NETCMIX_TOP_NETC_MDC	0x57e
			IMX95_PAD_ENET2_MDIO__NETCMIX_TOP_NETC_MDIO	0x97e
		>;
	};

	pinctrl_enetc0: enetc0grp {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__NETCMIX_TOP_ETH0_RGMII_TD3		0x57e
			IMX95_PAD_ENET1_TD2__NETCMIX_TOP_ETH0_RGMII_TD2		0x57e
			IMX95_PAD_ENET1_TD1__NETCMIX_TOP_ETH0_RGMII_TD1		0x57e
			IMX95_PAD_ENET1_TD0__NETCMIX_TOP_ETH0_RGMII_TD0		0x57e
			IMX95_PAD_ENET1_TX_CTL__NETCMIX_TOP_ETH0_RGMII_TX_CTL	0x57e
			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x58e
			IMX95_PAD_ENET1_RX_CTL__NETCMIX_TOP_ETH0_RGMII_RX_CTL	0x57e
			IMX95_PAD_ENET1_RXC__NETCMIX_TOP_ETH0_RGMII_RX_CLK	0x58e
			IMX95_PAD_ENET1_RD0__NETCMIX_TOP_ETH0_RGMII_RD0		0x57e
			IMX95_PAD_ENET1_RD1__NETCMIX_TOP_ETH0_RGMII_RD1		0x57e
			IMX95_PAD_ENET1_RD2__NETCMIX_TOP_ETH0_RGMII_RD2		0x57e
			IMX95_PAD_ENET1_RD3__NETCMIX_TOP_ETH0_RGMII_RD3		0x57e
		>;
	};

	pinctrl_enetc0_sleep: enetc0grp-sleep {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__GPIO4_IO_BIT2		0x200
			IMX95_PAD_ENET1_TD2__GPIO4_IO_BIT3		0x200
			IMX95_PAD_ENET1_TD1__GPIO4_IO_BIT4		0x200
			IMX95_PAD_ENET1_TD0__GPIO4_IO_BIT5		0x200
			IMX95_PAD_ENET1_TX_CTL__GPIO4_IO_BIT6		0x200
			IMX95_PAD_ENET1_TXC__GPIO4_IO_BIT7		0x200
			IMX95_PAD_ENET1_RX_CTL__GPIO4_IO_BIT8		0x200
			IMX95_PAD_ENET1_RXC__GPIO4_IO_BIT9		0x200
			IMX95_PAD_ENET1_RD0__GPIO4_IO_BIT10		0x200
			IMX95_PAD_ENET1_RD1__GPIO4_IO_BIT11		0x200
			IMX95_PAD_ENET1_RD2__GPIO4_IO_BIT12		0x200
			IMX95_PAD_ENET1_RD3__GPIO4_IO_BIT13		0x200
		>;
	};

	pinctrl_enetc1: enetc1grp {
		fsl,pins = <
			IMX95_PAD_ENET2_TD3__NETCMIX_TOP_ETH1_RGMII_TD3		0x57e
			IMX95_PAD_ENET2_TD2__NETCMIX_TOP_ETH1_RGMII_TD2		0x57e
			IMX95_PAD_ENET2_TD1__NETCMIX_TOP_ETH1_RGMII_TD1		0x57e
			IMX95_PAD_ENET2_TD0__NETCMIX_TOP_ETH1_RGMII_TD0		0x57e
			IMX95_PAD_ENET2_TX_CTL__NETCMIX_TOP_ETH1_RGMII_TX_CTL	0x58e
			IMX95_PAD_ENET2_TXC__NETCMIX_TOP_ETH1_RGMII_TX_CLK	0x5fe
			IMX95_PAD_ENET2_RX_CTL__NETCMIX_TOP_ETH1_RGMII_RX_CTL	0x58e
			IMX95_PAD_ENET2_RXC__NETCMIX_TOP_ETH1_RGMII_RX_CLK	0x5fe
			IMX95_PAD_ENET2_RD0__NETCMIX_TOP_ETH1_RGMII_RD0		0x57e
			IMX95_PAD_ENET2_RD1__NETCMIX_TOP_ETH1_RGMII_RD1		0x57e
			IMX95_PAD_ENET2_RD2__NETCMIX_TOP_ETH1_RGMII_RD2		0x57e
			IMX95_PAD_ENET2_RD3__NETCMIX_TOP_ETH1_RGMII_RD3		0x57e
		>;
	};

	pinctrl_enetc1_sleep: enetc1grpsleep {
		fsl,pins = <
			IMX95_PAD_ENET2_TD3__GPIO4_IO_BIT16		0x200
			IMX95_PAD_ENET2_TD2__GPIO4_IO_BIT17		0x200
			IMX95_PAD_ENET2_TD1__GPIO4_IO_BIT18		0x200
			IMX95_PAD_ENET2_TD0__GPIO4_IO_BIT19		0x200
			IMX95_PAD_ENET2_TX_CTL__GPIO4_IO_BIT20		0x200
			IMX95_PAD_ENET2_TXC__GPIO4_IO_BIT21		0x200
			IMX95_PAD_ENET2_RX_CTL__GPIO4_IO_BIT22		0x200
			IMX95_PAD_ENET2_RXC__GPIO4_IO_BIT23		0x200
			IMX95_PAD_ENET2_RD0__GPIO4_IO_BIT24		0x200
			IMX95_PAD_ENET2_RD1__GPIO4_IO_BIT25		0x200
			IMX95_PAD_ENET2_RD2__GPIO4_IO_BIT26		0x200
			IMX95_PAD_ENET2_RD3__GPIO4_IO_BIT27		0x200
		>;
	};

	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO25__CAN2_TX			0x39e
			IMX95_PAD_GPIO_IO27__CAN2_RX			0x39e
		>;
	};

	pinctrl_flexcan2_sleep: flexcan2grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO25__GPIO2_IO_BIT25		0x200
			IMX95_PAD_GPIO_IO27__GPIO2_IO_BIT27		0x200
		>;
	};

	pinctrl_flexcan3: flexcan3grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO28__CAN3_TX			0x39e
			IMX95_PAD_GPIO_IO29__CAN3_RX			0x39e
		>;
	};

	pinctrl_flexcan3_sleep: flexcan3grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO28__GPIO2_IO_BIT28		0x200
			IMX95_PAD_GPIO_IO29__GPIO2_IO_BIT29		0x200
		>;
	};

	pinctrl_flexspi1: flexspi1grp {
		fsl,pins = <
			IMX95_PAD_XSPI1_SS0_B__GPIO5_IO_BIT10		0x31e
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11		0x31e
			IMX95_PAD_XSPI1_SCLK__FLEXSPI1_A_SCLK		0x3fe
			IMX95_PAD_XSPI1_DATA0__FLEXSPI1_A_DATA_BIT0	0x3fe
			IMX95_PAD_XSPI1_DATA1__FLEXSPI1_A_DATA_BIT1	0x3fe
			IMX95_PAD_XSPI1_DATA2__FLEXSPI1_A_DATA_BIT2	0x3fe
			IMX95_PAD_XSPI1_DATA3__FLEXSPI1_A_DATA_BIT3	0x3fe
		>;
	};

	pinctrl_flexspi1_sleep: flexspi1grpsleep {
		fsl,pins = <
			IMX95_PAD_XSPI1_SS0_B__GPIO5_IO_BIT10		0x200
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11		0x200
			IMX95_PAD_XSPI1_SCLK__GPIO5_IO_BIT9		0x200
			IMX95_PAD_XSPI1_DATA0__GPIO5_IO_BIT0		0x200
			IMX95_PAD_XSPI1_DATA1__GPIO5_IO_BIT1		0x200
			IMX95_PAD_XSPI1_DATA2__GPIO5_IO_BIT2		0x200
			IMX95_PAD_XSPI1_DATA3__GPIO5_IO_BIT3		0x200
		>;
	};

	pinctrl_lpi2c2: lpi2c2grp {
		fsl,pins = <
			IMX95_PAD_I2C2_SCL__AONMIX_TOP_LPI2C2_SCL	0x40000b9e
			IMX95_PAD_I2C2_SDA__AONMIX_TOP_LPI2C2_SDA	0x40000b9e
		>;
	};

	pinctrl_lpi2c2_sleep: lpi2c2grpsleep {
		fsl,pins = <
			IMX95_PAD_I2C2_SCL__AONMIX_TOP_GPIO1_IO_BIT2	0x200
			IMX95_PAD_I2C2_SDA__AONMIX_TOP_GPIO1_IO_BIT3	0x200
		>;
	};

	pinctrl_lpi2c4: lpi2c4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO30__LPI2C4_SDA			0x40000b9e
			IMX95_PAD_GPIO_IO31__LPI2C4_SCL			0x40000b9e
		>;
	};

	pinctrl_lpi2c4_sleep: lpi2c4grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO30__GPIO2_IO_BIT30		0x200
			IMX95_PAD_GPIO_IO31__GPIO2_IO_BIT31		0x200
		>;
	};

	pinctrl_lpi2c5: lpi2c5grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO22__LPI2C5_SDA			0x40000b9e
			IMX95_PAD_GPIO_IO23__LPI2C5_SCL			0x40000b9e
		>;
	};

	pinctrl_lpi2c5_sleep: lpi2c5grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO22__GPIO2_IO_BIT22		0x200
			IMX95_PAD_GPIO_IO23__GPIO2_IO_BIT23		0x200
		>;
	};

	pinctrl_lpi2c7: lpi2c7grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO08__LPI2C7_SDA			0x40000b9e
			IMX95_PAD_GPIO_IO09__LPI2C7_SCL			0x40000b9e
		>;
	};

	pinctrl_lpi2c7_sleep: lpi2c7grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO08__GPIO2_IO_BIT8		0x200
			IMX95_PAD_GPIO_IO09__GPIO2_IO_BIT9		0x200
		>;
	};

	pinctrl_lpi2c8: lpi2c8grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO12__LPI2C8_SDA			0x40000b9e
			IMX95_PAD_GPIO_IO13__LPI2C8_SCL			0x40000b9e
		>;
	};

	pinctrl_lpi2c8_sleep: lpi2c8grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO12__GPIO2_IO_BIT12		0x200
			IMX95_PAD_GPIO_IO13__GPIO2_IO_BIT13		0x200
		>;
	};

	pinctrl_lpspi1: lpspi1grp {
		fsl,pins = <
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_LPSPI1_SCK		0x3fe
			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_LPSPI1_SOUT		0x3fe
			IMX95_PAD_SAI1_TXC__AONMIX_TOP_LPSPI1_SIN		0x3fe
			/* CS0 */
			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11		0x31e
			/* CS1 */
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x31e
		>;
	};

	pinctrl_lpspi1_sleep: lpspi1grpsleep {
		fsl,pins = <
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x200
			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11		0x200
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_GPIO1_IO_BIT13		0x200
			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_GPIO1_IO_BIT14		0x200
			IMX95_PAD_SAI1_TXC__AONMIX_TOP_GPIO1_IO_BIT12		0x200
		>;
	};

	pinctrl_mca: mcagrp {
		fsl,pins = <
			/* MCA/PMIC interrupt */
			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7		0x31e
		>;
	};

	pinctrl_sai3: sai3grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO17__SAI3_MCLK			0x31e
			IMX95_PAD_GPIO_IO16__SAI3_TX_BCLK		0x31e
			IMX95_PAD_GPIO_IO26__SAI3_TX_SYNC		0x31e
			IMX95_PAD_GPIO_IO20__SAI3_RX_DATA_BIT0		0x31e
			IMX95_PAD_GPIO_IO21__SAI3_TX_DATA_BIT0		0x31e
		>;
	};

	pinctrl_sai3_sleep: sai3grpsleep {
		fsl,pins = <
			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17		0x200
			IMX95_PAD_GPIO_IO16__GPIO2_IO_BIT16		0x200
			IMX95_PAD_GPIO_IO26__GPIO2_IO_BIT26		0x200
			IMX95_PAD_GPIO_IO20__GPIO2_IO_BIT20		0x200
			IMX95_PAD_GPIO_IO21__GPIO2_IO_BIT21		0x200
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			IMX95_PAD_UART1_RXD__AONMIX_TOP_LPUART1_RX	0x31e
			IMX95_PAD_UART1_TXD__AONMIX_TOP_LPUART1_TX	0x31e
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO15__LPUART3_RX			0x31e
			IMX95_PAD_GPIO_IO14__LPUART3_TX			0x31e
		>;
	};

	pinctrl_uart7: uart7grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO37__LPUART7_RX			0x31e
			IMX95_PAD_GPIO_IO36__LPUART7_TX			0x31e
			IMX95_PAD_GPIO_IO10__LPUART7_CTS_B		0x31e
			IMX95_PAD_GPIO_IO11__LPUART7_RTS_B		0x31e
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
		fsl,pins = <
			IMX95_PAD_SD2_CD_B__GPIO3_IO_BIT0		0x31e
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x158e
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x138e
			IMX95_PAD_SD2_DATA0__USDHC2_DATA0		0x138e
			IMX95_PAD_SD2_DATA1__USDHC2_DATA1		0x138e
			IMX95_PAD_SD2_DATA2__USDHC2_DATA2		0x138e
			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x138e
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x158e
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x138e
			IMX95_PAD_SD2_DATA0__USDHC2_DATA0		0x138e
			IMX95_PAD_SD2_DATA1__USDHC2_DATA1		0x138e
			IMX95_PAD_SD2_DATA2__USDHC2_DATA2		0x138e
			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x138e
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x15fe
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x13fe
