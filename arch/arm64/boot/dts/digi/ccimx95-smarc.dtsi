			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x13fe
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	pinctrl_usdhc2_sleep: usdhc2grpsleep {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__GPIO3_IO_BIT1		0x200
			IMX95_PAD_SD2_CMD__GPIO3_IO_BIT2		0x200
			IMX95_PAD_SD2_DATA0__GPIO3_IO_BIT3		0x200
